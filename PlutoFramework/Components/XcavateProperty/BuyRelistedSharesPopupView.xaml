<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.XcavateProperty.BuyRelistedSharesPopupView"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
             IsVisible="{Binding IsVisible}"
             AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
             AbsoluteLayout.LayoutFlags="All">
    <card:BottomPopupCard Title="{Binding PopupTitle}"
                          IsShown="{Binding IsVisible}">
        <card:BottomPopupCard.View>
            <AbsoluteLayout>

                <VerticalStackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, AutoSize"
                         AbsoluteLayout.LayoutFlags="WidthProportional"
                         x:Name="verticalStackLayout"
                         Spacing="20"
                                     Padding="10, 10, 10, 10">

                    <AbsoluteLayout Margin="10, 0, 10, -10">
                        <Label Text="Property:"
                                AbsoluteLayout.LayoutBounds="0,0,AutoSize, AutoSize"/>
                        <Label Text="{Binding PropertyName}"
                               HorizontalTextAlignment="End"
                               AbsoluteLayout.LayoutBounds="1,0,AutoSize, AutoSize"
                               AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    </AbsoluteLayout>

                    <AbsoluteLayout Margin="10, 0, 10, -10">
                        <Label Text="Tokens:"
                                AbsoluteLayout.LayoutBounds="0,0,AutoSize, AutoSize"/>
                        <Label Text="{Binding AmountText}"
                               HorizontalTextAlignment="End"
                               AbsoluteLayout.LayoutBounds="1,0,AutoSize, AutoSize"
                               AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    </AbsoluteLayout>

                    <AbsoluteLayout Margin="10, 0, 10, -10">
                        <Label Text="Price per token:"
                                AbsoluteLayout.LayoutBounds="0,0,AutoSize, AutoSize"/>
                        <Label Text="{Binding PricePerTokenText}"
                               HorizontalTextAlignment="End"
                               AbsoluteLayout.LayoutBounds="1,0,AutoSize, AutoSize"
                               AbsoluteLayout.LayoutFlags="PositionProportional"/>
                    </AbsoluteLayout>

                    <AbsoluteLayout Margin="10, 0, 10, -10">
                        <Label AbsoluteLayout.LayoutBounds="0,0,AutoSize, AutoSize">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Total price:"
                                            FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label AbsoluteLayout.LayoutBounds="1,0,AutoSize, AutoSize"
                               AbsoluteLayout.LayoutFlags="PositionProportional"
                               HorizontalTextAlignment="End">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding TotalText}"
                                          FontAttributes="Bold" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </AbsoluteLayout>

                    <Label Text="{Binding PaymentNote}"
                           FontSize="12"
                           Opacity="0.7" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorIsVisible}"
                           TextColor="Red" />

                </VerticalStackLayout>
                <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 1, 1, 80"
                    AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional">

                    <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 50"
                      AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                      ColumnSpacing="15"
                      Margin="10, 0, 10, 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <buttons:BasicGrayButton Text="Cancel" Grid.Column="0"
                                                 Command="{Binding CancelCommand}"/>

                        <buttons:PlutoFrameworkElevatedButton Text="Continue"
                                                               Grid.Column="1"
                                                               Command="{Binding ContinueCommand}"
                                                               ButtonState="{Binding ContinueButtonState}"/>
                    </Grid>
                </AbsoluteLayout>

            </AbsoluteLayout>

        </card:BottomPopupCard.View>
    </card:BottomPopupCard>
</ContentView>
