<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.XcavateProperty.DeveloperPropertyCardView"
             x:Name="root"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:xcavateproperty="clr-namespace:PlutoFramework.Components.XcavateProperty"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
             HorizontalOptions="Fill">

    <!-- The marketplace card's rows, filled from the developer's own record rather than a
         listing: location, name with gross yield, then shares and price. A draft mid-form
         has no finances section, so those rows hide instead of showing zeroes. -->
    <card:Card CardPadding="0, 0, 0, 0"
               HorizontalOptions="Fill">
        <!-- The tap has to sit on the card itself, beside the recognizer Card is born with:
             MAUI gestures do not bubble, so a recognizer attached to this ContentView wrapper
             is swallowed by the card's own and never fires. -->
        <card:ClickableCard.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference root}, Path=TapCommand}"
                                  CommandParameter="{Binding Source={x:Reference root}, Path=PropertyRecord}" />
        </card:ClickableCard.GestureRecognizers>
        <card:Card.View>
        <!-- The record, not the page's binding context, so every binding below reads it
             directly. The value itself comes from the PropertyRecord bindable property. -->
        <Grid BindingContext="{Binding Source={x:Reference root}, Path=PropertyRecord}">
            <VerticalStackLayout HorizontalOptions="Fill"
                                 Spacing="5">
                <AbsoluteLayout HorizontalOptions="Fill"
                                HeightRequest="200">
                    <!-- A draft usually has no photo at all - the image is uploaded at the end
                         of the form, long after the draft exists - so the fallback is the same
                         placeholder every other image in the app uses. -->
                    <ffimageloading:CachedImage Aspect="AspectFill"
                                                BackgroundColor="{AppThemeBinding Light=#dddddd, Dark=#222222}"
                                                x:Name="image"
                                                AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                                                AbsoluteLayout.LayoutFlags="All"
                                                InputTransparent="True" />

                    <!-- What kind of property it is, top left like the web item's badge. -->
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#0a0a0a}"
                            StrokeThickness="0"
                            AbsoluteLayout.LayoutBounds="0, 0, AutoSize, AutoSize"
                            AbsoluteLayout.LayoutFlags="PositionProportional"
                            Margin="10, 10, 0, 0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <Label Margin="8, 2, 8, 2"
                               FontSize="12"
                               Text="{Binding TypeText}"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center" />
                    </Border>

                </AbsoluteLayout>

                <Grid ColumnSpacing="5"
                      Margin="10, 5, 10, 0"
                      InputTransparent="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <xcavateproperty:LocationView LocationName="{Binding LocationText}"
                                                  HorizontalOptions="Start"
                                                  VerticalOptions="Center"
                                                  Grid.Column="0" />

                    <Border BackgroundColor="#22888888"
                            StrokeThickness="0"
                            Grid.Column="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="5" />
                        </Border.StrokeShape>
                        <Label Margin="5, 0, 5, 0"
                               Text="{Binding StatusText}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"
                               VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Grid ColumnSpacing="5"
                      Margin="10, 0, 10, 0"
                      InputTransparent="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label FontAttributes="Bold"
                           Text="{Binding NameText}"
                           HorizontalTextAlignment="Start"
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"
                           Grid.Column="0" />

                    <Label Text="Gross yield"
                           IsVisible="{Binding HasGrossYield}"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           Grid.Column="1" />

                    <Label Text="{Binding GrossYieldText}"
                           FontAttributes="Bold"
                           IsVisible="{Binding HasGrossYield}"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           Grid.Column="2" />
                </Grid>

                <Grid ColumnSpacing="5"
                      Margin="10, 0, 10, 10"
                      IsVisible="{Binding HasFinances}"
                      InputTransparent="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label Text="Shares"
                           HorizontalTextAlignment="Start"
                           VerticalOptions="Center"
                           Grid.Column="0" />

                    <Label Text="{Binding SharesText}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Start"
                           VerticalOptions="Center"
                           Grid.Column="1" />

                    <Label Text="Price"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           Grid.Column="2" />

                    <Label Text="{Binding PriceText}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           Grid.Column="3" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
        </card:Card.View>
    </card:Card>
</ContentView>
