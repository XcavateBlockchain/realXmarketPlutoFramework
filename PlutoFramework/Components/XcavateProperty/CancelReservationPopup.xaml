<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.XcavateProperty.CancelReservationPopup"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
             IsVisible="{Binding IsVisible}"
             AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
             AbsoluteLayout.LayoutFlags="All">

    <card:BottomPopupCard Title="Cancel reservation"
                          IsShown="{Binding IsVisible}">
        <card:BottomPopupCard.View>
            <AbsoluteLayout>

                <VerticalStackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, AutoSize"
                                     AbsoluteLayout.LayoutFlags="WidthProportional"
                                     Spacing="20"
                                     Padding="20, 10, 20, 10">
                    <Label Text="Are you sure you want to cancel your reservation? Please understand that you might not be able to re-reserve this specific property again."
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                </VerticalStackLayout>

                <Grid AbsoluteLayout.LayoutBounds="0.5, 1, 1, 80"
                          AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                          ColumnSpacing="15"
                          RowSpacing="15"
                          Margin="10, 10, 10, 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <buttons:BasicGrayButton Text="Cancel"
                                                 Grid.Column="0"
                                                 Grid.Row="0"
                                                 Command="{Binding CancelCommand}"
                                                 ButtonState="Enabled"/>
                    <buttons:ElevatedButton Text="Proceed"
                            Grid.Column="1"
                            Grid.Row="0"
                            Command="{Binding ContinueCommand}"
                            ButtonState="Enabled"/>
                </Grid>
            </AbsoluteLayout>
        </card:BottomPopupCard.View>
    </card:BottomPopupCard>
</ContentView>