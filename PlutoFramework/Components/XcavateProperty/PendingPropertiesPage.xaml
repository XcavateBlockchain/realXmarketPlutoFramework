<?xml version="1.0" encoding="utf-8" ?>
<page:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.XcavateProperty.PendingPropertiesPage"
             xmlns:page="clr-namespace:PlutoFramework.Templates.PageTemplate"
             xmlns:xcavateproperty="clr-namespace:PlutoFramework.Components.XcavateProperty"
             xmlns:loading="clr-namespace:PlutoFramework.Components.Loading"
             Title="Pending properties">
    <RefreshView Command="{Binding RefreshCommand}"
                 IsRefreshing="{Binding IsRefreshing}">
        <ScrollView x:Name="mainScrollView"
                    Scrolled="OnMainScrollViewScrolled">
            <VerticalStackLayout Spacing="15"
                                 Padding="20, 15, 20, 100">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Properties}"
                                     Spacing="15">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <!-- The tap pushes the record's detail page, where the admin's
                                 approve / reject decision lives. -->
                            <xcavateproperty:DeveloperPropertyCardView PropertyRecord="{Binding .}"
                                                                       TapCommand="{Binding Source={RelativeSource AncestorType={x:Type page:PageTemplate}}, Path=BindingContext.OpenPropertyCommand}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <ActivityIndicator IsVisible="{Binding LoadingMore}"
                                   IsRunning="{Binding LoadingMore}"
                                   Color="{StaticResource Primary}" />

                <loading:SkeletonCardView ItemMargin="0,0,0,10"
                                          IsVisible="{Binding ShowSkeleton}" />
                <Label Text="{Binding EmptyListMessage}"
                       TextColor="#A6A6A6"
                       HorizontalOptions="Center"
                       Margin="20, 40, 20, 40"
                       IsVisible="{Binding NoProperties}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</page:PageTemplate>
