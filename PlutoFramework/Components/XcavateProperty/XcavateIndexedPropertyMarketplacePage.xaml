<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.XcavateProperty.XcavateIndexedPropertyMarketplacePage"
             xmlns:navigationbar="clr-namespace:PlutoFramework.Components.NavigationBar"
             xmlns:nft="clr-namespace:PlutoFramework.Components.Nft"
             xmlns:unique="clr-namespace:PlutoFramework.Components.Unique"
             xmlns:koda="clr-namespace:PlutoFramework.Components.Koda"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
             xmlns:txanalyzer="clr-namespace:PlutoFramework.Components.TransactionAnalyzer"
             xmlns:xcavateproperty="clr-namespace:PlutoFramework.Components.XcavateProperty"
             xmlns:transfer="clr-namespace:PlutoFramework.Components.TransferView"
             xmlns:account="clr-namespace:PlutoFramework.Components.Account"
             xmlns:keys="clr-namespace:PlutoFramework.Components.Keys"
             xmlns:assetselect="clr-namespace:PlutoFramework.Components.AssetSelect"
             xmlns:solana="clr-namespace:PlutoFramework.Components.Solana"
             HideSoftInputOnTapped="True"
             xmlns:extrinsic="clr-namespace:PlutoFramework.Components.Extrinsic"
             xmlns:loading="clr-namespace:PlutoFramework.Components.Loading"
             xmlns:animations="clr-namespace:PlutoFramework.Components.Animations"
             xmlns:xcavate="clr-namespace:PlutoFramework.Components.Xcavate"
             xmlns:transactionrequest="clr-namespace:PlutoFramework.Components.TransactionRequest"
             Shell.PresentationMode="NotAnimated"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             BackgroundColor="{AppThemeBinding Light=White, Dark=#0a0a0a}">

    <!--
        The risk-warning/search header, the loading skeleton and the empty-state caption are
        items of the feed itself (MarketplaceFeedTemplateSelector), so they scroll along with
        the property cards. They are NOT CollectionView.Header/Footer: on iOS those are hosted
        as UICollectionView supplementary views, and self-sizing ones (MeasureAllItems) crash
        this page on navigation. Plain list items are measured as regular cells, which is safe.
        The skeleton item sits directly under the header, exactly where the first property card
        appears; the view model inserts it only while the list is empty and loading, and the
        empty-state item only when nothing matched - hiding them with IsVisible would leave
        their measured space behind as a gap.
        The 90px bottom row keeps the list clear of the pinned XcavateNavigationBarView,
        which overlays the bottom of the page.
    -->
    <ContentPage.Resources>
        <xcavateproperty:MarketplaceFeedTemplateSelector x:Key="MarketplaceFeedTemplateSelector">
            <xcavateproperty:MarketplaceFeedTemplateSelector.HeaderTemplate>
                <DataTemplate>
                    <VerticalStackLayout Spacing="10">
                        <xcavate:RiskWarningView Margin="20,10,20,10" />

                        <VerticalStackLayout Margin="20,0,20,20" Spacing="12">
                            <Border Stroke="#C9CDD8"
                                    StrokeThickness="1"
                                    Padding="4"
                                    HorizontalOptions="Center"
                                    StrokeShape="RoundRectangle 26">
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="4">
                                    <Border Grid.Column="0"
                                            Padding="16,10"
                                            BackgroundColor="#3C4A74"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMarketplaceTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Marketplace"
                                               FontSize="14"
                                               TextColor="White"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Border>
                                    <Border Grid.Column="1"
                                            Padding="16,10"
                                            BackgroundColor="Transparent"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnNoticeboardTapped" />
                                        </Border.GestureRecognizers>
                                        <Label Text="Notice Board"
                                               FontSize="14"
                                               TextColor="#555555"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid ColumnDefinitions="*,62" ColumnSpacing="10">
                                <Border Grid.Column="0"
                                        Stroke="#3C4A74"
                                        StrokeThickness="2"
                                        HeightRequest="56"
                                        StrokeShape="RoundRectangle 28">
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Entry Grid.Column="0"
                                               Margin="18,0,0,0"
                                               Placeholder="Search"
                                               Text="{Binding ViewModel.SearchText}"
                                               ReturnType="Search"
                                               ReturnCommand="{Binding ViewModel.SearchCommand}"
                                               Completed="OnSearchCompleted"
                                               VerticalOptions="Center"
                                               BackgroundColor="Transparent"
                                               ClearButtonVisibility="Never" />
                                        <Image Grid.Column="1"
                                               Source="xcavatesearch.svg"
                                               HeightRequest="22"
                                               WidthRequest="22"
                                               Margin="0,0,18,0"
                                               VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ViewModel.SearchCommand}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        BackgroundColor="#E8E9ED"
                                        HeightRequest="56"
                                        WidthRequest="56"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 28">
                                    <ImageButton Source="xcavatesettings.png"
                                                 Command="{Binding ViewModel.OpenFilterCommand}"
                                                 BackgroundColor="Transparent"
                                                 HeightRequest="56"
                                                 WidthRequest="56"
                                                 Padding="14" />
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </xcavateproperty:MarketplaceFeedTemplateSelector.HeaderTemplate>

            <xcavateproperty:MarketplaceFeedTemplateSelector.SkeletonTemplate>
                <DataTemplate>
                    <loading:SkeletonCardView />
                </DataTemplate>
            </xcavateproperty:MarketplaceFeedTemplateSelector.SkeletonTemplate>

            <xcavateproperty:MarketplaceFeedTemplateSelector.EmptyStateTemplate>
                <DataTemplate>
                    <StackLayout HeightRequest="200">
                        <Label Text="{Binding ViewModel.NoItemsMessage}"
                               TextColor="#A6A6A6"
                               HorizontalOptions="Center"
                               Margin="20, 40, 20, 40"
                               HorizontalTextAlignment="Center"/>
                    </StackLayout>
                </DataTemplate>
            </xcavateproperty:MarketplaceFeedTemplateSelector.EmptyStateTemplate>

            <xcavateproperty:MarketplaceFeedTemplateSelector.PropertyTemplate>
                <DataTemplate>
                    <xcavateproperty:PropertyThumbnailView XcavateNftWrapper="{Binding .}"
                                                           Padding="20, 5, 20, 10" />
                </DataTemplate>
            </xcavateproperty:MarketplaceFeedTemplateSelector.PropertyTemplate>
        </xcavateproperty:MarketplaceFeedTemplateSelector>
    </ContentPage.Resources>

    <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1" AbsoluteLayout.LayoutFlags="All">

        <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1" AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="*,90">

            <RefreshView Grid.Row="0"
                Command="{Binding RefreshCommand}"
                RefreshColor="Transparent"
                IsRefreshing="{Binding IsRefreshing}">

                <RefreshView.Behaviors>
                    <animations:PullProgressBehavior x:Name="marketplacePullProgress" />
                </RefreshView.Behaviors>

                <CollectionView ItemSizingStrategy="MeasureAllItems"
                        ItemsSource="{Binding FeedItems}"
                        ItemTemplate="{StaticResource MarketplaceFeedTemplateSelector}"
                        RemainingItemsThreshold="0"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical"
                                           ItemSpacing="0" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
            </RefreshView>
        </Grid>

        <animations:ParticleStreamView AbsoluteLayout.LayoutBounds="0, 0, 1, 100"
                                       AbsoluteLayout.LayoutFlags="XProportional,WidthProportional"
                                       ParticleColor="{StaticResource Primary}"
                                       Playing="{Binding IsRefreshing}"
                                       PullProgress="{Binding Source={x:Reference marketplacePullProgress}, Path=Progress}" />

        <extrinsic:ExtrinsicStatusStackLayout />

        <xcavate:XcavateNavigationBarView />

        <transfer:TransferView />

        <txanalyzer:TransactionAnalyzerConfirmationView />

        <transactionrequest:MessageSignRequestView />

        <assetselect:AssetSelectView />

        <account:NoAccountPopup ZIndex="10" />

        <!-- Raised by the messenger gate (MessengerAccessModel); hosted here because this
             page is not a PageTemplate. -->
        <keys:X25519KeyRequiredPopupView ZIndex="10" />

        <solana:ConnectMwaPopupView ZIndex="10" />

        <xcavateproperty:PropertyMarketplaceFilterPopupView />

        <xcavateproperty:PropertyMarketplaceSelectionPopupView />

        <loading:FullPageLoadingView ZIndex="20" />

        <card:BottomPillBackgroundView />
    </AbsoluteLayout>
</ContentPage>
