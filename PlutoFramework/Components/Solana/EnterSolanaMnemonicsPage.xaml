<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       xmlns:keys="clr-namespace:PlutoFramework.Components.Keys"
                       x:Class="PlutoFramework.Components.Solana.EnterSolanaMnemonicsPage"
                       Title="Import Solana wallet">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="20, 20, 20, 100"
                             Spacing="15">
            <ContentView HeightRequest="160">
                <card:Card>
                    <card:Card.View>
                        <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                                        AbsoluteLayout.LayoutFlags="All"
                                        Margin="0, 10, 0, 10">
                            <VerticalStackLayout AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                                                 AbsoluteLayout.LayoutFlags="SizeProportional">
                                <Label FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       VerticalTextAlignment="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontAttributes="Bold"
                                                  Text="Your Solana seed phrase: " />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Editor HeightRequest="120"
                                        x:Name="mnemonicsEntry"
                                        AutomationId="solanaMnemonicsEntry"
                                        Placeholder="Start entering here.."
                                        Text="{Binding Mnemonics}" />
                            </VerticalStackLayout>
                        </AbsoluteLayout>
                    </card:Card.View>
                </card:Card>
            </ContentView>

            <!-- Lets the user confirm the address matches their existing wallet before importing. -->
            <VerticalStackLayout Spacing="4"
                                 IsVisible="{Binding AddressPreviewIsVisible}">
                <Label Text="This phrase unlocks the address"
                       FontSize="12"
                       TextColor="#A6A6A6"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding AddressPreview}"
                       FontFamily="SourceCode"
                       FontSize="13"
                       LineBreakMode="MiddleTruncation"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Label Text="That is not a valid seed phrase."
                   IsVisible="{Binding IncorrectMnemonicsEntered}"
                   HorizontalTextAlignment="Center" />

            <buttons:ElevatedButton Text="Continue"
                                    AutomationId="ContinueSolanaMnemonics"
                                    Command="{Binding ContinueWithMnemonicsCommand}" />
        </VerticalStackLayout>
    </ScrollView>

    <template:PageTemplate.PopupContent>
        <keys:CanNotRecoverKeyPopupView />
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
