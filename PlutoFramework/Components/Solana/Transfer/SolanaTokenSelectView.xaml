<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:transfer="clr-namespace:PlutoFramework.Components.Solana.Transfer"
             x:Class="PlutoFramework.Components.Solana.Transfer.SolanaTokenSelectView"
             IsVisible="{Binding IsTokenSelectVisible}"
             AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
             AbsoluteLayout.LayoutFlags="All">

    <card:BottomPopupCard Title="Select token"
                          IsShown="{Binding IsTokenSelectVisible}">
        <card:BottomPopupCard.View>
            <ScrollView>
                <VerticalStackLayout Padding="10, 10, 10, 20"
                                     Spacing="10">

                    <Label Text="{Binding LoadError}"
                           IsVisible="{Binding LoadErrorIsVisible}"
                           TextColor="#C33"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Balances}"
                                         Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <transfer:SolanaTokenSelectRowView Balance="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </card:BottomPopupCard.View>
    </card:BottomPopupCard>

</ContentView>
