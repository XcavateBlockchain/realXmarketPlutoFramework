<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:mnemonics="clr-namespace:PlutoFramework.Components.Mnemonics"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       xmlns:address="clr-namespace:PlutoFramework.Components.AddressView"
                       x:Class="PlutoFramework.Components.Solana.CreateSolanaMnemonicsPage"
                       Title="New Solana wallet">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="20, 10, 20, 100"
                             Spacing="15">
            <Label Text="Your Solana wallet has been created!"
                   FontAttributes="Bold"
                   FontSize="20"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <address:AddressView Title="Solana address"
                                 Address="{Binding Address}" />

            <mnemonics:MnemonicsView Title="Seed phrase:"
                                     Mnemonics="{Binding Mnemonics}" />

            <Label Text="Write this phrase down and keep it somewhere safe. It is the only way to recover this wallet, and anyone who has it can spend your funds."
                   FontSize="12"
                   TextColor="#A6A6A6"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>

    <template:PageTemplate.PopupContent>
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0.5, 1, 1, AutoSize"
                             AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                             Padding="20, 10, 20, 10"
                             Spacing="15">
            <buttons:ElevatedButton Text="I have saved it"
                                    ButtonState="Enabled"
                                    Command="{Binding ContinueCommand}" />
        </VerticalStackLayout>
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
