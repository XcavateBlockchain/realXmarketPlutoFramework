<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:status="clr-namespace:PlutoFramework.Components.Solana.Status"
             x:Class="PlutoFramework.Components.Solana.Status.SolanaTransactionStatusStackLayout"
             IsVisible="{Binding IsVisible}"
             HeightRequest="{Binding HeightRequest}"
             AbsoluteLayout.LayoutBounds="{Binding LayoutBounds}"
             AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
             Margin="20, 20, 20, 20"
             TranslationY="20">
    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TransactionInfos}"
                         Spacing="15">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <status:SolanaTransactionStatusView />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
