<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
             xmlns:mnemonics="clr-namespace:PlutoFramework.Components.Mnemonics"
             xmlns:address="clr-namespace:PlutoFramework.Components.AddressView"
             x:Class="PlutoFramework.Components.Solana.CreateSolanaMnemonicsPopupView"
             IsVisible="{Binding IsVisible}"
             AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
             AbsoluteLayout.LayoutFlags="All">

    <card:BottomPopupCard Title="Your new Solana wallet"
                          IsShown="{Binding IsVisible}">
        <card:BottomPopupCard.View>
            <AbsoluteLayout>
                <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                            AbsoluteLayout.LayoutFlags="All"
                            Margin="0, 0, 0, 90">
                    <VerticalStackLayout Spacing="15"
                                         Padding="10, 10, 10, 20">

                        <address:AddressView Title="Solana address"
                                             Address="{Binding Address}" />

                        <mnemonics:MnemonicsView Title="Seed phrase:"
                                                 Mnemonics="{Binding Mnemonics}" />

                        <Label Text="Write this phrase down and keep it somewhere safe. It is the only way to recover this wallet, and anyone who has it can spend your funds."
                               FontSize="12"
                               TextColor="#A6A6A6"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </ScrollView>

                <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 1, 1, 80"
                                AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional">
                    <Grid AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 50"
                          AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                          ColumnSpacing="15"
                          Margin="10, 0, 10, 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <buttons:ElevatedButton Text="I have saved it"
                                                Grid.Column="0"
                                                AutomationId="ConfirmSolanaMnemonicsSaved"
                                                ButtonState="Enabled"
                                                Command="{Binding ContinueCommand}" />
                    </Grid>
                </AbsoluteLayout>
            </AbsoluteLayout>
        </card:BottomPopupCard.View>
    </card:BottomPopupCard>
</ContentView>
