<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
             x:Class="PlutoFramework.Components.Solana.MwaSignPopupView"
             IsVisible="{Binding IsVisible}"
             AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
             AbsoluteLayout.LayoutFlags="All">

    <card:BottomPopupCard Title="Waiting for signature from wallet"
                          IsShown="{Binding IsVisible}">
        <card:BottomPopupCard.View>
            <VerticalStackLayout Spacing="15"
                                 Padding="10, 10, 10, 20">

                <Label Text="{Binding Reason}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       Margin="10, 0, 10, 0" />

                <Label Text="Approve the request in your Solana wallet app. The wallet shows you exactly what is being signed and hands back only the signature - your keys never leave it."
                       FontSize="13"
                       HorizontalTextAlignment="Center" />

                <Label Text="If your wallet did not open, open it manually to review the request."
                       FontSize="12"
                       TextColor="#A6A6A6"
                       HorizontalTextAlignment="Center" />

                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10"
                                       IsVisible="{Binding StatusIsVisible}">
                    <ActivityIndicator IsRunning="{Binding IsVisible}"
                                       HeightRequest="16"
                                       WidthRequest="16"
                                       VerticalOptions="Center" />

                    <Label Text="{Binding Status}"
                           FontSize="13"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <buttons:BasicGrayButton Text="Cancel"
                                         AutomationId="cancelMwaSignature"
                                         Command="{Binding CancelCommand}"
                                         Margin="10, 5, 10, 0" />
            </VerticalStackLayout>
        </card:BottomPopupCard.View>
    </card:BottomPopupCard>
</ContentView>
