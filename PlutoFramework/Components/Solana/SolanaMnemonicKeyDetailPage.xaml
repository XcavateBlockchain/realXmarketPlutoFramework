<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       xmlns:mnemonics="clr-namespace:PlutoFramework.Components.Mnemonics"
                       xmlns:address="clr-namespace:PlutoFramework.Components.AddressView"
                       x:Class="PlutoFramework.Components.Solana.SolanaMnemonicKeyDetailPage"
                       Title="Solana key">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="20, 10, 20, 100"
                             Spacing="15">

            <address:AddressView Title="Solana address"
                                 Address="{Binding Address}"
                                 QrAddress="{Binding QrAddress}" />

            <mnemonics:MnemonicsView Title="Seed phrase:"
                                     Mnemonics="{Binding Mnemonics}" />

            <Label Text="Derived at m/44'/501'/0'/0', the same path Phantom, Solflare and Backpack use, so this phrase can be imported into any of them."
                   FontSize="12"
                   TextColor="#A6A6A6"
                   HorizontalTextAlignment="Center" />

            <buttons:ElevatedButton ButtonState="Enabled"
                                    Text="What are mnemonics?"
                                    Command="{Binding GoToMnemonicsExplanationCommand}" />

            <buttons:ElevatedButton ButtonState="Warning"
                                    Text="Delete"
                                    Command="{Binding DeleteSolanaKeyCommand}" />
        </VerticalStackLayout>
    </ScrollView>

    <template:PageTemplate.PopupContent>
        <address:AddressQrCodeView />
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
