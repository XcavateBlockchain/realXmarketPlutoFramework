<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card"
                       xmlns:address="clr-namespace:PlutoFramework.Components.AddressView"
                       xmlns:xcavate="clr-namespace:PlutoFramework.Components.Xcavate"
                       xmlns:ffimageloading="clr-namespace:FFImageLoading.Maui;assembly=FFImageLoading.Maui"
                       xmlns:model="clr-namespace:PlutoFramework.Model;assembly=PlutoFrameworkCore"
                       x:Class="PlutoFramework.Components.Solana.SolanaTokenDetailPage"
                       x:Name="page"
                       Title="{Binding Symbol}">

    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout Spacing="15"
                             Padding="0, 0, 0, 100">

            <!-- Price block. Absent entirely for a stablecoin: a flat line would imply a
                 volatility the token does not have. -->
            <VerticalStackLayout Spacing="5"
                                 Margin="-10, 20, -10, 0"
                                 IsVisible="{Binding ChartIsVisible}">

                <AbsoluteLayout HorizontalOptions="Fill"
                                HeightRequest="300"
                                IsVisible="{Binding HasHistory}">
                    <microcharts:ChartView Chart="{Binding Chart}"
                                           AbsoluteLayout.LayoutBounds="0,0,1,300"
                                           AbsoluteLayout.LayoutFlags="WidthProportional" />

                    <Label AbsoluteLayout.LayoutBounds="{Binding MinLayoutBounds}"
                           AbsoluteLayout.LayoutFlags="PositionProportional"
                           TextColor="{StaticResource Primary}"
                           IsVisible="{Binding MinMaxIsVisible}"
                           Margin="{Binding MinMargin}"
                           FontAttributes="Bold"
                           Text="{Binding MinText}" />

                    <Label AbsoluteLayout.LayoutBounds="{Binding MaxLayoutBounds}"
                           AbsoluteLayout.LayoutFlags="PositionProportional"
                           TextColor="{StaticResource Primary}"
                           IsVisible="{Binding MinMaxIsVisible}"
                           Margin="{Binding MaxMargin}"
                           FontAttributes="Bold"
                           Text="{Binding MaxText}" />
                </AbsoluteLayout>

                <!-- Replaces the chart rather than sitting beside it. The interval buttons
                     stay put, so switching range is how the user retries. -->
                <Label Text="Price history unavailable"
                       IsVisible="{Binding HistoryIsUnavailable}"
                       HeightRequest="300"
                       TextColor="#A6A6A6"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />

                <Grid IsVisible="{Binding HasHistory}"
                      ColumnDefinitions="*,*,*,*">
                    <Label Grid.Column="0"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Text="{Binding Time1Text}" />
                    <Label Grid.Column="1"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Text="{Binding Time2Text}" />
                    <Label Grid.Column="2"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Text="{Binding Time3Text}" />
                    <Label Grid.Column="3"
                           HorizontalOptions="Center"
                           TextColor="Gray"
                           Text="{Binding Time4Text}" />
                </Grid>

                <Grid ColumnSpacing="10"
                      HorizontalOptions="Center"
                      ColumnDefinitions="Auto,Auto,Auto">
                    <buttons:ChoiceTextButton Grid.Column="0"
                                              Text="1d"
                                              Command="{Binding ChangeChartIntervalCommand}"
                                              CommandParameter="{x:Static model:Interval.Hourly}"
                                              IsSelected="{Binding HourlyIsSelected}" />
                    <buttons:ChoiceTextButton Grid.Column="1"
                                              Text="3w"
                                              Command="{Binding ChangeChartIntervalCommand}"
                                              CommandParameter="{x:Static model:Interval.Daily}"
                                              IsSelected="{Binding DailyIsSelected}" />
                    <buttons:ChoiceTextButton Grid.Column="2"
                                              Text="6m"
                                              Command="{Binding ChangeChartIntervalCommand}"
                                              CommandParameter="{x:Static model:Interval.Weekly}"
                                              IsSelected="{Binding WeeklyIsSelected}" />
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15"
                                 Margin="20, 20, 20, 0">

                <!-- Holdings -->
                <card:Card>
                    <card:Card.View>
                        <Grid ColumnDefinitions="60,*"
                              RowDefinitions="Auto,Auto"
                              Padding="15, 15, 15, 15"
                              ColumnSpacing="10">

                            <Image Grid.Column="0"
                                   Grid.RowSpan="2"
                                   Source="{Binding IconSource}"
                                   Aspect="AspectFit"
                                   HeightRequest="44"
                                   WidthRequest="44"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="1"
                                   Grid.Row="0"
                                   Text="{Binding Symbol}"
                                   FontAttributes="Bold"
                                   FontSize="20" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Grid.Row="1"
                                                 Spacing="2">
                                <Label Text="{Binding AmountText}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding UsdValueText}"
                                       FontSize="13"
                                       TextColor="#A6A6A6" />
                            </VerticalStackLayout>
                        </Grid>
                    </card:Card.View>
                </card:Card>

                <!-- tGBP only: the amount property reservations hold, broken down per
                     property - each row opens that property's detail page. Hidden unless
                     the indexer confirmed a non-zero reserved value. -->
                <card:Card IsVisible="{Binding ReservedSectionIsVisible}">
                    <card:Card.View>
                        <VerticalStackLayout Padding="15, 12, 15, 15"
                                             Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Reserved for properties"
                                       FontSize="14"
                                       TextColor="#A6A6A6"
                                       VerticalTextAlignment="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding TgBpReservedText}"
                                       FontAttributes="Bold"
                                       FontSize="14"
                                       VerticalTextAlignment="Center" />
                            </Grid>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding ReservedProperties}"
                                                 Spacing="12">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="44,*,Auto,Auto"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="12">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference page}, Path=BindingContext.OpenPropertyCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>

                                            <Border Grid.Column="0"
                                                    Grid.RowSpan="2"
                                                    Padding="0"
                                                    HeightRequest="44"
                                                    WidthRequest="44"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light=#dddddd, Dark=#222222}">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}" />
                                                </Border.StrokeShape>
                                                <ffimageloading:CachedImage Source="{Binding ImageSource}"
                                                                            Aspect="AspectFill"
                                                                            HeightRequest="44"
                                                                            WidthRequest="44" />
                                            </Border>

                                            <Label Grid.Column="1"
                                                   Grid.Row="0"
                                                   Text="{Binding NameText}"
                                                   FontAttributes="Bold"
                                                   FontSize="14"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalTextAlignment="End" />

                                            <Label Grid.Column="1"
                                                   Grid.Row="1"
                                                   Text="{Binding SubtitleText}"
                                                   FontSize="12"
                                                   TextColor="#A6A6A6"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalTextAlignment="Start" />

                                            <Label Grid.Column="2"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   Text="{Binding ValueText}"
                                                   FontAttributes="Bold"
                                                   FontSize="13"
                                                   VerticalTextAlignment="Center" />

                                            <Image Grid.Column="3"
                                                   Grid.Row="0"
                                                   Grid.RowSpan="2"
                                                   WidthRequest="10"
                                                   HeightRequest="10"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <FontImageSource Glyph="&#xf054;"
                                                                     FontFamily="FontAwesome"
                                                                     Size="10"
                                                                     Color="#A6A6A6" />
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </card:Card.View>
                </card:Card>

                <!-- Live price. Chartable tokens only; a stablecoin has no movement to report. -->
                <card:Card IsVisible="{Binding ChartIsVisible}">
                    <card:Card.View>
                        <Grid ColumnDefinitions="*,Auto,Auto"
                              Padding="15, 12, 15, 12"
                              ColumnSpacing="10">
                            <Label Grid.Column="0"
                                   Text="Price"
                                   FontSize="14"
                                   TextColor="#A6A6A6"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PriceText}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   Text="{Binding ChangeText}"
                                   IsVisible="{Binding ChangeIsVisible}"
                                   TextColor="{Binding ChangeColor}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </card:Card.View>
                </card:Card>

                <!-- On-chain facts -->
                <card:Card>
                    <card:Card.View>
                        <VerticalStackLayout Padding="15, 12, 15, 12"
                                             Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Network"
                                       FontSize="14"
                                       TextColor="#A6A6A6" />
                                <Label Grid.Column="1"
                                       Text="{Binding NetworkName}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="6">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CopyMintCommand}" />
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0"
                                       Text="Mint"
                                       FontSize="14"
                                       TextColor="#A6A6A6" />
                                <Label Grid.Column="1"
                                       Text="{Binding MintShort}"
                                       FontFamily="SourceCode"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Image Grid.Column="2"
                                       WidthRequest="14"
                                       HeightRequest="14"
                                       VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xf0c5;"
                                                         FontFamily="FontAwesome"
                                                         Size="14"
                                                         Color="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                    </Image.Source>
                                </Image>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="Decimals"
                                       FontSize="14"
                                       TextColor="#A6A6A6" />
                                <Label Grid.Column="1"
                                       Text="{Binding DecimalsText}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                            </Grid>
                        </VerticalStackLayout>
                    </card:Card.View>
                </card:Card>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

    <template:PageTemplate.PopupContent>
        <xcavate:PageBottomBarView AbsoluteLayout.LayoutBounds="0.5, 1, 1, 90"
                                   AbsoluteLayout.LayoutFlags="PositionProportional, WidthProportional"
                                   ColumnSpacing="10">
            <xcavate:PageBottomBarView.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </xcavate:PageBottomBarView.ColumnDefinitions>

            <buttons:ElevatedButton Text="Receive"
                                    Command="{Binding ReceiveCommand}"
                                    Grid.Column="0"
                                    Margin="10, 10, 0, 10" />

            <!-- Opens the transfer popup with this token already chosen. -->
            <buttons:ElevatedButton Text="Transfer"
                                    Command="{Binding TransferCommand}"
                                    Grid.Column="1"
                                    Margin="0, 10, 10, 10" />
        </xcavate:PageBottomBarView>

        <address:AddressQrCodeView />
        <!-- SolanaTransferView and SolanaTokenSelectView are supplied by the page template. -->
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
