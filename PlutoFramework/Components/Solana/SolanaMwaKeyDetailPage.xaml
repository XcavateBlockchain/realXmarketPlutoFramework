<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       xmlns:address="clr-namespace:PlutoFramework.Components.AddressView"
                       x:Class="PlutoFramework.Components.Solana.SolanaMwaKeyDetailPage"
                       Title="Solana wallet">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="20, 10, 20, 100"
                             Spacing="15">

            <address:AddressView Title="Solana address"
                                 Address="{Binding Address}"
                                 QrAddress="{Binding QrAddress}" />

            <card:Card>
                <card:Card.View>
                    <VerticalStackLayout Padding="15, 10, 15, 10"
                                         Spacing="8">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Wallet"
                                   FontSize="14"
                                   TextColor="#A6A6A6" />

                            <Label Grid.Column="1"
                                   Text="{Binding WalletName}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="Network"
                                   FontSize="14"
                                   TextColor="#A6A6A6" />

                            <Label Grid.Column="1"
                                   Text="{Binding ClusterName}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                        </Grid>
                    </VerticalStackLayout>
                </card:Card.View>
            </card:Card>

            <Label Text="This wallet signs on your behalf. No private key for it is stored on this device, so there is no seed phrase to back up here."
                   FontSize="12"
                   TextColor="#A6A6A6"
                   HorizontalTextAlignment="Center" />

            <buttons:ElevatedButton ButtonState="{Binding DisconnectButtonState}"
                                    Text="Disconnect"
                                    Command="{Binding DisconnectCommand}" />
        </VerticalStackLayout>
    </ScrollView>

    <template:PageTemplate.PopupContent>
        <address:AddressQrCodeView />
    </template:PageTemplate.PopupContent>
</template:PageTemplate>
