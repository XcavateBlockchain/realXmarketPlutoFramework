<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:card="clr-namespace:PlutoFramework.Components.Card"
                       xmlns:buttons="clr-namespace:PlutoFramework.Components.Buttons"
                       x:Class="PlutoFramework.Components.Solana.ConnectMwaPage"
                       Title="Connect Solana wallet">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">
        <VerticalStackLayout HorizontalOptions="Center"
                             Padding="20, 20, 20, 100"
                             Spacing="15">

            <Label Text="Connect an existing Solana wallet app on this device. Your seed phrase never leaves that app - this app only receives permission to request signatures."
                   FontSize="13"
                   HorizontalTextAlignment="Center" />

            <!-- Android-only: the protocol relies on intents and Digital Asset Links. -->
            <VerticalStackLayout IsVisible="{Binding IsUnsupported}"
                                 Spacing="10"
                                 Margin="0, 30, 0, 0">
                <Label Text="Not available on this platform"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Label Text="Mobile Wallet Adapter is specified for Android only. On this device, create or import a Solana seed phrase instead."
                       FontSize="12"
                       TextColor="#A6A6A6"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsSupported}"
                                 Spacing="15">
                <card:Card>
                    <card:Card.View>
                        <VerticalStackLayout Padding="15, 10, 15, 10"
                                             Spacing="5">
                            <Label Text="Network"
                                   FontAttributes="Bold"
                                   FontSize="14" />

                            <Label Text="{Binding NetworkName}"
                                   FontSize="14"
                                   AutomationId="solanaClusterName" />

                            <Label Text="Change the network in Settings. An authorization is only valid for the network it was granted on."
                                   FontSize="11"
                                   TextColor="#A6A6A6" />
                        </VerticalStackLayout>
                    </card:Card.View>
                </card:Card>

                <buttons:ElevatedButton Text="Connect wallet"
                                        AutomationId="connectMwaWallet"
                                        ButtonState="{Binding ConnectButtonState}"
                                        Command="{Binding ConnectCommand}" />

                <HorizontalStackLayout HorizontalOptions="Center"
                                       Spacing="10"
                                       IsVisible="{Binding StatusIsVisible}">
                    <ActivityIndicator IsRunning="{Binding IsConnecting}"
                                       HeightRequest="16"
                                       WidthRequest="16"
                                       VerticalOptions="Center" />

                    <Label Text="{Binding Status}"
                           FontSize="13"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorIsVisible}"
                       FontSize="13"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</template:PageTemplate>
