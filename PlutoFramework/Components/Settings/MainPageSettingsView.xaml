<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:card="clr-namespace:PlutoFramework.Components.Card"
             xmlns:settings="clr-namespace:PlutoFramework.Components.Settings"
             x:Class="PlutoFramework.Components.Settings.MainPageSettingsView"
             x:DataType="settings:MainPageSettingsViewModel"
             x:Name="mainPageSettingsView">
    <card:Card>
        <card:Card.View>
            <VerticalStackLayout Padding="15, 12, 15, 12"
                                 Spacing="8">
                <Label Text="Main page"
                       FontAttributes="Bold"
                       FontSize="14" />

                <FlexLayout BindableLayout.ItemsSource="{Binding Roles}"
                            IsEnabled="{Binding IsReady}"
                            Wrap="Wrap">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="settings:MainPageRoleOption">
                            <Border Padding="16, 8"
                                    Margin="0, 0, 8, 8"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Primary}"
                                    BackgroundColor="Transparent"
                                    AutomationId="{Binding AutomationId}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20" />
                                </Border.StrokeShape>

                                <Label Text="{Binding Text}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource DarkThemeWhite}}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor"
                                                    Value="{StaticResource White}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor"
                                                Value="{StaticResource Primary}" />
                                    </DataTrigger>
                                </Border.Triggers>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference mainPageSettingsView}, Path=BindingContext.SelectRoleCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <Label Text="Choose which main page opens. The change applies immediately. Letting Agent currently uses the investor page."
                       FontSize="11"
                       TextColor="#A6A6A6" />
            </VerticalStackLayout>
        </card:Card.View>
    </card:Card>
</ContentView>
