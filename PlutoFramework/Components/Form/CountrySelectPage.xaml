<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       x:Class="PlutoFramework.Components.Form.CountrySelectPage"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate"
                       xmlns:form="clr-namespace:PlutoFramework.Components.Form"
                       x:Name="page"
                       Title="Select country">

    <Grid RowDefinitions="Auto, *">

        <!--
          The search box sits outside the list rather than in its header: the filter replaces
          the item source on every keystroke, and a header is part of the list's own recycler,
          so the box would lose the keyboard mid-word on Android.

          The top margin clears the navigation bar, which PageTemplate draws over the page
          rather than above it. The list below is offset by the template itself, which is where
          the space between the two comes from.
        -->
        <VerticalStackLayout Grid.Row="0"
                             Margin="20, 50, 20, 0">
            <form:FormInputView Placeholder="Search by country, code or +number"
                                ReturnType="Search"
                                Text="{Binding SearchText}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Countries}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No country matches that search."
                       Margin="20, 20, 20, 20"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Gray400}" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *, Auto, 25"
                          ColumnSpacing="15"
                          Padding="20, 12, 20, 12">

                        <!-- Drawn by the system emoji font, so there is no image asset per country. -->
                        <Label Text="{Binding Flag}"
                               Grid.Column="0"
                               FontSize="24"
                               VerticalTextAlignment="Center" />

                        <Label Text="{Binding Name}"
                               Grid.Column="1"
                               LineBreakMode="TailTruncation"
                               VerticalTextAlignment="Center" />

                        <Label Text="{Binding DialCode}"
                               Grid.Column="2"
                               TextColor="{StaticResource Gray400}"
                               VerticalTextAlignment="Center" />

                        <Label Text="&#x2713;"
                               Grid.Column="3"
                               IsVisible="{Binding IsSelected}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="End"
                               VerticalTextAlignment="Center" />

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference page}, Path=BindingContext.SelectCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</template:PageTemplate>
