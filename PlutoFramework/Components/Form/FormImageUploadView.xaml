<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.Form.FormImageUploadView">
    <VerticalStackLayout Spacing="0">

        <Label x:Name="titleLabel"
               FontSize="14"
               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />

        <BoxView HeightRequest="1"
                 Margin="0, 8, 0, 0"
                 Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                 HorizontalOptions="Fill" />

        <Border Margin="0, 12, 0, 0"
                Padding="20, 28"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                StrokeThickness="1.5"
                StrokeDashArray="4, 3"
                HorizontalOptions="Fill">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnSelectTapped" />
            </Border.GestureRecognizers>

            <Grid>
                <Image x:Name="image"
                       Aspect="AspectFill"
                       HeightRequest="200"
                       IsVisible="False" />

                <VerticalStackLayout x:Name="placeholderContent"
                                     Spacing="10"
                                     HorizontalOptions="Center">

                    <Border HeightRequest="56"
                            WidthRequest="56"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Label Text="+"
                               FontSize="24"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                    </Border>

                    <Label Margin="0, 6, 0, 0"
                           FontAttributes="Bold"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           Text="Drop your files here"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray100}}" />

                    <Label FontSize="13"
                           HorizontalTextAlignment="Center"
                           Text="Max 10 files &#183; Up to 10MB"
                           TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray400}}" />

                    <Border Margin="0, 8, 0, 0"
                            Padding="20, 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                            Stroke="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                            StrokeThickness="1.5"
                            HorizontalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <HorizontalStackLayout Spacing="8">
                            <Image HeightRequest="16"
                                   WidthRequest="16"
                                   VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Color="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                                     FontFamily="FontAwesome"
                                                     Glyph="&#xf093;"
                                                     Size="16" />
                                </Image.Source>
                            </Image>
                            <Label FontSize="14"
                                   Text="Select files"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </Grid>
        </Border>
    </VerticalStackLayout>
</ContentView>
