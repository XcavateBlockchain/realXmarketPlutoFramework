<?xml version="1.0" encoding="utf-8" ?>
<page:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                   x:Class="PlutoFramework.Components.Keys.CreateNewKeyPage"
                   xmlns:keys="clr-namespace:PlutoFramework.Components.Keys"
                   xmlns:page="clr-namespace:PlutoFramework.Templates.PageTemplate"
                   xmlns:solana="clr-namespace:PlutoFramework.Components.Solana"
                   Title="Generate new key">
    <ScrollView AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                AbsoluteLayout.LayoutFlags="All">

        <VerticalStackLayout Spacing="15" Padding="20, 20, 20, 100">

            <keys:NewKeyView KeyType="EncryptionX25519" />

            <keys:NewKeyView KeyType="SolanaMnemonic" />

            <keys:NewKeyView KeyType="SolanaMwa" />

        </VerticalStackLayout>
    </ScrollView>

    <page:PageTemplate.PopupContent>
        <!-- ConnectMwaPopupView is supplied by the page template. -->
        <solana:CreateSolanaMnemonicsPopupView />
        <solana:EnterSolanaMnemonicsPopupView />
    </page:PageTemplate.PopupContent>
</page:PageTemplate>