<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PlutoFramework.Components.Nft.NftMultiImageView"
             xmlns:nft="clr-namespace:PlutoFramework.Components.Nft">
    <VerticalStackLayout Spacing="10">
        <nft:NftImageView x:Name="mainImage" />

        <CollectionView x:Name="thumbnailsCollectionView"
                        HeightRequest="60"
                        SelectionMode="Single"
                        SelectionChanged="OnThumbnailSelectionChanged"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- Lean thumbnail: the full NftImageView (shadow wrapper, grey
                         background, hidden action buttons, AbsoluteLayout) is wasted on a
                         60px preview and its per-item shadow bitmap is pure cost. -->
                    <Border WidthRequest="60"
                            HeightRequest="60"
                            Padding="0"
                            StrokeThickness="0"
                            BackgroundColor="Gray">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CardCornerRadius}" />
                        </Border.StrokeShape>
                        <Image Source="{Binding .}"
                               Aspect="AspectFill" />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
