<?xml version="1.0" encoding="utf-8" ?>
<template:PageTemplate xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:template="clr-namespace:PlutoFramework.Templates.PageTemplate;assembly=PlutoFramework"
                       xmlns:local="clr-namespace:PlutoFramework.Components.Messages"
                       x:Class="PlutoFramework.Components.Messages.MessageWebViewPage"
                       Title="Messages"
                       BackgroundColor="{AppThemeBinding Light=White, Dark=#0a0a0a}">
    <AbsoluteLayout AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                    Margin="0, 65, 0, 0"
                    AbsoluteLayout.LayoutFlags="All">
        <local:X25519WebView
                        x:Name="webView"
                        AbsoluteLayout.LayoutBounds="0.5, 0.5, 1, 1"
                        AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
    
</template:PageTemplate>